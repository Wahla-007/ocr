# ==============================================================================
# UNIVERSAL DOCUMENT EXTRACTION PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development | staging | production)
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
API_PORT=8000
API_HOST=0.0.0.0
API_SECRET_KEY=change-me-to-a-secure-random-secret-in-production-32-chars-min
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=openocr
POSTGRES_PASSWORD=openocr_secure_pass
POSTGRES_DB=openocr
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://openocr:openocr_secure_pass@localhost:5432/openocr
DATABASE_URL_SYNC=postgresql+psycopg2://openocr:openocr_secure_pass@localhost:5432/openocr

# ------------------------------------------------------------------------------
# Redis (Cache, Queues, Rate Limiting, SSE)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Object Storage (S3-compatible: MinIO for local dev, R2 for production)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=documents
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# ------------------------------------------------------------------------------
# Parse Engines (Docling, Surya, PaddleOCR)
# ------------------------------------------------------------------------------
PARSE_ENGINE_PRIMARY=docling
PARSE_ENGINE_FALLBACK=paddleocr

# ------------------------------------------------------------------------------
# LLM Providers (gemini | anthropic | openai)
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Web Application
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Monitoring (Optional in dev)
# ------------------------------------------------------------------------------
SENTRY_DSN=

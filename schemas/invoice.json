{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InvoiceSchema",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Invoice number or identifier"
    },
    "issue_date": {
      "type": "string",
      "description": "Date of invoice issuance in YYYY-MM-DD format"
    },
    "due_date": {
      "type": "string",
      "description": "Date payment is due in YYYY-MM-DD format"
    },
    "vendor_name": {
      "type": "string",
      "description": "Name of supplier or issuing company"
    },
    "customer_name": {
      "type": "string",
      "description": "Name of billed client or recipient"
    },
    "subtotal": {
      "type": "number",
      "description": "Subtotal before tax"
    },
    "tax_amount": {
      "type": "number",
      "description": "Tax or VAT amount"
    },
    "total_amount": {
      "type": "number",
      "description": "Total amount due"
    },
    "currency": {
      "type": "string",
      "description": "Currency code (USD, EUR, GBP, PKR, etc.)"
    }
  },
  "required": ["invoice_number", "total_amount"]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PassportSchema",
  "type": "object",
  "properties": {
    "passport_number": {
      "type": "string",
      "description": "Unique passport document number"
    },
    "full_name": {
      "type": "string",
      "description": "Full legal name of the passport holder"
    },
    "surname": {
      "type": "string",
      "description": "Surname or family name / Nom"
    },
    "given_names": {
      "type": "string",
      "description": "Given names / Prénoms"
    },
    "nationality": {
      "type": "string",
      "description": "Country of citizenship or issuing country code"
    },
    "date_of_birth": {
      "type": "string",
      "description": "Date of birth in YYYY-MM-DD format"
    },
    "place_of_birth": {
      "type": "string",
      "description": "Place / city / country of birth"
    },
    "gender": {
      "type": "string",
      "description": "Gender or sex (e.g. M, F, X)"
    },
    "issue_date": {
      "type": "string",
      "description": "Date of issue in YYYY-MM-DD format"
    },
    "expiry_date": {
      "type": "string",
      "description": "Date of expiration in YYYY-MM-DD format"
    },
    "issuing_authority": {
      "type": "string",
      "description": "Issuing authority or passport office location"
    },
    "issuing_country": {
      "type": "string",
      "description": "Issuing country name or 3-letter code"
    },
    "mrz_line1": {
      "type": "string",
      "description": "Machine Readable Zone line 1"
    },
    "mrz_line2": {
      "type": "string",
      "description": "Machine Readable Zone line 2"
    }
  },
  "required": ["passport_number", "full_name"]
}

# OpenOCR Self-Hosted Configuration
# ==============================================================================
# Environment
ENV=production
OPENOCR_SELF_HOSTED=true

# Server Ports
API_PORT=8000
WEB_PORT=3000

# Execution & Concurrency
ONNXRUNTIME_EXECUTION_PROVIDERS=CPUExecutionProvider
MAX_WORKERS=4
MAX_PAGE_LIMIT=500

# Storage & Privacy (100% Local, zero cloud egress)
LOCAL_STORAGE_DIR=/app/data
PERSIST_UPLOADS=false
LOG_LEVEL=info
